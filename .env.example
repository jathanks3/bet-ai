# Copy this file to .env.local and adjust as needed. Vite only exposes
# variables prefixed with VITE_ to the browser bundle - never put secrets
# here, since anything here ships to the client.

# Display name shown in the app header. Defaults to "BetAI".
VITE_APP_NAME=BetAI

# Base artificial delay (ms) the mock analysis service waits before
# responding, so the loading/thinking state feels realistic. Set to 0 for
# instant responses during local development or automated testing.
VITE_MOCK_DELAY_MS=700

# --- Reserved for when a real backend is connected (not used yet) ---
# VITE_API_BASE_URL=
# VITE_SPORTS_DATA_API_KEY=
